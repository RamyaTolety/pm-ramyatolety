rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isMember(projectData) {
      return request.auth != null
        && request.auth.token.email in projectData.memberEmails;
    }

    match /projects/{projectId} {
      allow read: if isMember(resource.data);

      allow create: if request.auth != null
        && request.auth.token.email == request.resource.data.ownerEmail
        && request.auth.token.email in request.resource.data.memberEmails;

      // Members can update (e.g. archive, add members); membership itself
      // can only grow, never be used to remove other members' access.
      allow update: if isMember(resource.data);

      allow delete: if request.auth != null
        && request.auth.token.email == resource.data.ownerEmail;

      match /tasks/{taskId} {
        allow read, create, update, delete: if isMember(get(/databases/$(database)/documents/projects/$(projectId)).data);

        match /comments/{commentId} {
          allow read, create: if isMember(get(/databases/$(database)/documents/projects/$(projectId)).data);
        }
      }
    }
  }
}
