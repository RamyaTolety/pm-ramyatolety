rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isMember(projectData) {
      return request.auth != null
        && request.auth.token.email in projectData.memberEmails;
    }

    match /projects/{projectId} {
      allow read: if isMember(resource.data);

      allow create: if request.auth != null
        && request.auth.token.email == request.resource.data.ownerEmail
        && request.auth.token.email in request.resource.data.memberEmails;

      // Members can update (e.g. archive, add members, edit name/description),
      // but ownerEmail is immutable via update — otherwise any member could
      // rewrite ownership onto themselves and then delete the project, since
      // delete only checks ownerEmail.
      allow update: if isMember(resource.data)
        && request.resource.data.ownerEmail == resource.data.ownerEmail;

      allow delete: if request.auth != null
        && request.auth.token.email == resource.data.ownerEmail;

      match /tasks/{taskId} {
        allow read, create, update, delete: if isMember(get(/databases/$(database)/documents/projects/$(projectId)).data);

        match /comments/{commentId} {
          allow read, create: if isMember(get(/databases/$(database)/documents/projects/$(projectId)).data);
        }

        match /checklistItems/{itemId} {
          allow read, create, update, delete: if isMember(get(/databases/$(database)/documents/projects/$(projectId)).data);
        }
      }
    }
  }
}
